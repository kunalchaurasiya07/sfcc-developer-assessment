<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    <!--
        Mock endpoint (Beeceptor). Replace URL / user / password with the real fulfilment
        service values in BM (Administration > Operations > Services > Credentials).
        The password is intentionally not part of this file - set it in BM.
    -->
    <service-credential service-credential-id="fulfilment.http.credentials">
        <url>https://sfcc-fulfilment.free.beeceptor.com</url>
        <user-id>storefront</user-id>
    </service-credential>

    <service-profile service-profile-id="fulfilment.http.profile">
        <timeout-millis>2000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>5</cb-calls>
        <cb-millis>10000</cb-millis>
    </service-profile>

    <service service-id="fulfilment.http.get">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>fulfilment</log-prefix>
        <comm-log-enabled>true</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>true</mock-mode-enabled>
        <profile-id>fulfilment.http.profile</profile-id>
        <credential-id>fulfilment.http.credentials</credential-id>
    </service>
</services>
